        "kpis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "support_process": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weekly_review_format": {
          "type": "array",
