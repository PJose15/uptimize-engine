        "audit_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audit_event_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retention_policy": {
          "type": "string"
        },
        "where_logs_live": {
          "type": "string"
        }
      }
    }
