  "definitions": {
    "phase_plan": {
      "type": "object",
      "required": [
        "goal",
        "deliverables",
        "time_to_value",
        "dependencies"
      ],
      "properties": {
        "goal": {
          "type": "string"
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "time_to_value": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
