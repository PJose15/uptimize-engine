# =============================================================================
# Uptimize Engine — Environment Configuration
# =============================================================================
# Copy to .env and fill in. `.env` is gitignored; never commit real secrets.
#
# Vars marked REQUIRED are validated on boot by lib/env.ts — the app fails
# fast with a clear message instead of erroring deep inside an agent call.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (REQUIRED)
# -----------------------------------------------------------------------------
# SQLite for local dev. For serverless deploys (Vercel), switch the datasource
# in prisma/schema.prisma to postgresql — see docs/POSTGRES_MIGRATION.md.
DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------------------
# Auth & CSRF (REQUIRED)
# -----------------------------------------------------------------------------
# Signing secret for CSRF tokens (lib/csrf.ts). Generate with:
#   openssl rand -hex 32
NEXTAUTH_SECRET=""

# Seed credentials for the admin user (prisma/seed.ts).
# Password must be at least 12 characters.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# -----------------------------------------------------------------------------
# AI Providers (at least one REQUIRED)
# -----------------------------------------------------------------------------
# The provider fallback chains in lib/config/models.ts skip providers whose key
# is absent, so you only need keys for the tiers you actually intend to use.
# ANTHROPIC_API_KEY is the default for BALANCED/QUALITY work.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
MISTRAL_API_KEY=""
PERPLEXITY_API_KEY=""

# -----------------------------------------------------------------------------
# Model tier overrides (optional)
# -----------------------------------------------------------------------------
# Override the per-tier defaults in lib/config/models.ts without a code change.
# MODEL_FAST="gemini-2.0-flash"
# MODEL_BALANCED="claude-sonnet-4-20250514"
# MODEL_QUALITY="claude-opus-4-20250514"
# MODEL_MINI="gpt-4o-mini"
# MODEL_RESEARCH="sonar-pro"

# -----------------------------------------------------------------------------
# Agent execution path (optional)
# -----------------------------------------------------------------------------
# "true" routes Agents 1-5 through the v2 sub-agent orchestrators (each agent
# splits into two specialist sub-agents with tier-based model routing, and each
# sub-agent run is recorded in SubAgentRun). Anything else keeps the legacy
# single-call path. Both paths accept the same inputs and return the same
# output shape, so the flag can be flipped to compare cost and quality.
USE_SUBAGENTS="false"

# -----------------------------------------------------------------------------
# Research tools (optional)
# -----------------------------------------------------------------------------
# Brave Search powers Agent 1's live research (lib/research/brave-search.ts).
# Without it Agent 1 falls back to model knowledge only.
BRAVE_API_KEY=""

# -----------------------------------------------------------------------------
# Google Sheets lead ingestion (optional)
# -----------------------------------------------------------------------------
# Service-account credentials for /api/integrations/sheets/leads.
# GOOGLE_PRIVATE_KEY must keep its literal \n escapes when quoted.
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_SPREADSHEET_ID=""
GOOGLE_SHEET_RANGE="Sheet1!A2:G1000"

# -----------------------------------------------------------------------------
# Webhooks & cron (optional)
# -----------------------------------------------------------------------------
# API key required by POST /api/webhooks/trigger. If unset, the endpoint
# rejects every request — there is no default key.
WEBHOOK_API_KEY=""

# Base URL the webhook handler calls back into. Set to the deployed origin.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Notifications (optional)
# -----------------------------------------------------------------------------
SLACK_WEBHOOK_URL=""
NOTIFICATION_EMAIL_TO=""
NOTIFICATION_EMAIL_FROM="noreply@uptimize.local"
